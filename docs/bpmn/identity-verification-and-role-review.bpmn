<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Registration" targetNamespace="https://ranti.local/bpmn/phase2">
  <bpmn:process id="Process_Registration" name="Registro o reenvío de desafío" isExecutable="false">
    <bpmn:documentation>Registro y reenvío terminan pendientes; confirmación empieza en otra petición. Errores SQL internos en issueChallenge revierten esa transacción, no el INSERT previo de cuenta. Evidencia: server/src/modules/identity/identity.service.js; server/test/identity.integration.test.js. Por confirmar: gobierno operativo de términos/proveedores, alta administrativa, retención de evidencia y despliegue de outbox.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Registration">
      <bpmn:lane id="Lane_Registration_Actor" name="Usuario"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/identity/identity.service.js; server/test/identity.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Registration_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_input</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Registration_System" name="Sistema"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/identity/identity.service.js; server/test/identity.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Registration_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_bad</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_kind</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_insert</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_insertResult</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_dup</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_dbError</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_issue</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_eligible</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_invalid</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_provider</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_available</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_unavailable</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_save</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_saved</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_pending</bpmn:flowNodeRef><bpmn:flowNodeRef>Registration_error</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Registration_start" name="Petición register / resend">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/src/modules/identity/identity.service.js::resendVerification. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:outgoing>Registration_Flow_start_input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Registration_input" name="Correo institucional y consentimiento">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::registrationInput; client/src/features/auth/Register.jsx::request. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_start_input</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_input_valid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Registration_valid" name="¿Entrada válida?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::parse; server/src/modules/identity/identity.service.js::registrationInput. Prueba: server/test/identity.integration.test.js. Dominio UCSM/subdominio válido; términos true, versión y contraseña válida en registro.</bpmn:documentation>
      <bpmn:incoming>Registration_Flow_input_valid</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_valid_bad</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_valid_kind</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Registration_bad" name="Rechazo 400: dominio / términos / datos">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::parse. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_valid_bad</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Registration_kind" name="¿Registro o reenvío?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/src/modules/identity/identity.service.js::resendVerification. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_valid_kind</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_kind_insert</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_kind_issue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Registration_insert" name="Guardar Egresado pendiente (autocommit)">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount. Prueba: server/test/identity.integration.test.js. La cuenta queda confirmada antes de solicitar desafío; duplicado 23505 =&gt; 409 IDENTITY_CONFLICT.</bpmn:documentation>
      <bpmn:incoming>Registration_Flow_kind_insert</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_insert_insertResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Registration_insertResult" name="¿Cuenta guardada?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_insert_insertResult</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_insertResult_dup</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_insertResult_dbError</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_insertResult_issue</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Registration_dup" name="Rechazo 409: correo duplicado">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_insertResult_dup</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Registration_dbError" name="Error 500 de persistencia">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::safeError; server/src/modules/identity/identity.service.js::transaction. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_insertResult_dbError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Registration_issue" name="BEGIN; bloquear cuenta e invalidar desafíos">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/src/modules/identity/identity.service.js::canVerify. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_kind_issue</bpmn:incoming>
      <bpmn:incoming>Registration_Flow_insertResult_issue</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_issue_eligible</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Registration_eligible" name="¿Cuenta pendiente elegible?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::canVerify; server/src/modules/identity/identity.service.js::issueChallenge. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_issue_eligible</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_eligible_invalid</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_eligible_provider</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Registration_invalid" name="Rechazo 400; rollback desafío">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/src/modules/identity/identity.service.js::invalidChallenge. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_eligible_invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Registration_provider" name="Solicitar desafío simulado">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/src/modules/identity/simulated-identity-provider.js::requestVerification. Prueba: server/test/identity.integration.test.js. Adaptador local: no intercambio de mensajes externo, SSO ni correo.</bpmn:documentation>
      <bpmn:incoming>Registration_Flow_eligible_provider</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_provider_available</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Registration_available" name="¿Proveedor disponible?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_provider_available</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_available_unavailable</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_available_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Registration_unavailable" name="Pendiente 202: reenviar después">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge. Prueba: server/test/identity.integration.test.js. COMMIT de invalidación previa; cuenta pendiente conservada; verification_unavailable, retryable. Nuevo resend es otra petición.</bpmn:documentation>
      <bpmn:incoming>Registration_Flow_available_unavailable</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Registration_save" name="Guardar hash, vencimiento e intentos; COMMIT">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_available_save</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_save_saved</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Registration_saved" name="¿Transacción confirmada?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::transaction. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Registration_Flow_save_saved</bpmn:incoming>
      <bpmn:outgoing>Registration_Flow_saved_pending</bpmn:outgoing>
      <bpmn:outgoing>Registration_Flow_saved_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Registration_pending" name="Pendiente: verification_pending">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge. Prueba: server/test/identity.integration.test.js. 201 registro / 200 reenvío; sin JWT. simulation_code solo si configuración explícita.</bpmn:documentation>
      <bpmn:incoming>Registration_Flow_saved_pending</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Registration_error" name="Error 500: rollback del desafío">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::transaction. Prueba: server/test/identity.integration.test.js. La cuenta registrada antes sigue pendiente.</bpmn:documentation>
      <bpmn:incoming>Registration_Flow_saved_error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="Object_Registration_data"><bpmn:documentation>Confirmada. Evidencia: server/src/db/migrations/003_identity_publications.sql. Prueba: server/test/identity.integration.test.js. Hash; expiración diez minutos; máximo cinco intentos; consentimiento en users.</bpmn:documentation></bpmn:dataObject>
    <bpmn:dataObjectReference id="Registration_data" name="users / identity_challenges" dataObjectRef="Object_Registration_data">
      <bpmn:documentation>Confirmada. Evidencia: server/src/db/migrations/003_identity_publications.sql. Prueba: server/test/identity.integration.test.js. Hash; expiración diez minutos; máximo cinco intentos; consentimiento en users.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="Registration_Flow_start_input" sourceRef="Registration_start" targetRef="Registration_input"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/src/modules/identity/identity.service.js::resendVerification; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_input_valid" sourceRef="Registration_input" targetRef="Registration_valid"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/identity/identity.service.js::registrationInput; client/src/features/auth/Register.jsx::request; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_valid_bad" sourceRef="Registration_valid" targetRef="Registration_bad" name="No"><bpmn:documentation>Confirmada. Condición: No. Evidencia: server/src/modules/identity/identity.service.js::parse; server/src/modules/identity/identity.service.js::registrationInput; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_valid_kind" sourceRef="Registration_valid" targetRef="Registration_kind" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/identity/identity.service.js::parse; server/src/modules/identity/identity.service.js::registrationInput; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_kind_insert" sourceRef="Registration_kind" targetRef="Registration_insert" name="Registro"><bpmn:documentation>Confirmada. Condición: Registro. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/src/modules/identity/identity.service.js::resendVerification; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_kind_issue" sourceRef="Registration_kind" targetRef="Registration_issue" name="Reenvío"><bpmn:documentation>Confirmada. Condición: Reenvío. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/src/modules/identity/identity.service.js::resendVerification; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_insert_insertResult" sourceRef="Registration_insert" targetRef="Registration_insertResult"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_insertResult_dup" sourceRef="Registration_insertResult" targetRef="Registration_dup" name="Correo existente"><bpmn:documentation>Confirmada. Condición: Correo existente. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_insertResult_dbError" sourceRef="Registration_insertResult" targetRef="Registration_dbError" name="Fallo SQL"><bpmn:documentation>Confirmada. Condición: Fallo SQL. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_insertResult_issue" sourceRef="Registration_insertResult" targetRef="Registration_issue" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/identity/identity.service.js::registerPendingAccount; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_issue_eligible" sourceRef="Registration_issue" targetRef="Registration_eligible"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/src/modules/identity/identity.service.js::canVerify; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_eligible_invalid" sourceRef="Registration_eligible" targetRef="Registration_invalid" name="No"><bpmn:documentation>Confirmada. Condición: No. Evidencia: server/src/modules/identity/identity.service.js::canVerify; server/src/modules/identity/identity.service.js::issueChallenge; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_eligible_provider" sourceRef="Registration_eligible" targetRef="Registration_provider" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/identity/identity.service.js::canVerify; server/src/modules/identity/identity.service.js::issueChallenge; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_provider_available" sourceRef="Registration_provider" targetRef="Registration_available"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/src/modules/identity/simulated-identity-provider.js::requestVerification; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_available_unavailable" sourceRef="Registration_available" targetRef="Registration_unavailable" name="No"><bpmn:documentation>Confirmada. Condición: No. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_available_save" sourceRef="Registration_available" targetRef="Registration_save" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_save_saved" sourceRef="Registration_save" targetRef="Registration_saved"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/identity/identity.service.js::issueChallenge; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_saved_pending" sourceRef="Registration_saved" targetRef="Registration_pending" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/identity/identity.service.js::transaction; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Registration_Flow_saved_error" sourceRef="Registration_saved" targetRef="Registration_error" name="No"><bpmn:documentation>Confirmada. Condición: No. Evidencia: server/src/modules/identity/identity.service.js::transaction; server/test/identity.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_Confirmation" name="Confirmación de identidad" isExecutable="false">
    <bpmn:documentation>Las expiraciones y fallos de código son rechazos con contabilidad confirmada, no rollback de intentos. Evidencia: server/src/modules/identity/identity.service.js; server/test/identity.integration.test.js. Por confirmar: gobierno operativo de términos/proveedores, alta administrativa, retención de evidencia y despliegue de outbox.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Confirmation">
      <bpmn:lane id="Lane_Confirmation_Actor" name="Usuario"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/identity/identity.service.js; server/test/identity.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Confirmation_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_code</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Confirmation_System" name="Sistema"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/identity/identity.service.js; server/test/identity.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Confirmation_checks</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_invalid</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_expiry</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_expire</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_verify</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_result</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_outage</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_attempt</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_wrong</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_again</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_activate</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_commit</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_error</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirmation_success</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Confirmation_start" name="POST verification/confirm">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::verifyPendingAccount. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:outgoing>Confirmation_Flow_start_code</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Confirmation_code" name="Ingresar challengeId y seis dígitos">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::confirmationInput; client/src/features/auth/Register.jsx::request. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Confirmation_Flow_start_code</bpmn:incoming>
      <bpmn:outgoing>Confirmation_Flow_code_checks</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Confirmation_checks" name="¿Cuenta/desafío utilizables?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::verifyPendingAccount. Prueba: server/test/identity.integration.test.js. Validación input; bloquear usuario antes de desafío; sent, registration, proveedor/email, intentos &lt; máximo.</bpmn:documentation>
      <bpmn:incoming>Confirmation_Flow_code_checks</bpmn:incoming>
      <bpmn:outgoing>Confirmation_Flow_checks_invalid</bpmn:outgoing>
      <bpmn:outgoing>Confirmation_Flow_checks_expiry</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Confirmation_invalid" name="Rechazo: reutilizado / agotado / inválido">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::verifyPendingAccount; server/src/modules/identity/identity.service.js::invalidChallenge. Prueba: server/test/identity.integration.test.js. 400 IDENTITY_INVALID_CHALLENGE; rollback sin activación.</bpmn:documentation>
      <bpmn:incoming>Confirmation_Flow_checks_invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Confirmation_expiry" name="¿Expirado antes de verificar?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::verifyPendingAccount::expired. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Confirmation_Flow_checks_expiry</bpmn:incoming>
      <bpmn:outgoing>Confirmation_Flow_expiry_expire</bpmn:outgoing>
      <bpmn:outgoing>Confirmation_Flow_expiry_verify</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Confirmation_expire" name="Persistir expired; COMMIT">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/identity/identity.service.js::verifyPendingAccount. Prueba: server/test/identity.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Confirmation_Flow_expiry_expire</bpmn:incoming>
      <bpmn:incoming>Confirmation_Flow_again_expire</bpmn:incoming>
      <bpmn:outgoing>Confirmation_Flow_expire_rejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Confirmation_rejected" name="Rechazo 400: desafío expirado">
