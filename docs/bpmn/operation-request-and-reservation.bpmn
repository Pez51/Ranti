  <bpmn:process id="Process_Expiry" isExecutable="false">
    <bpmn:documentation>Fuente: server/src/routes/operation.routes.js; server/src/modules/operations/operation.service.js; server/src/db/migrations/006_operations_reservations.sql. Modelo descriptivo, no ejecutable.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Process_Expiry">
      <bpmn:lane id="Lane_Process_Expiry_Proceso_automatico" name="Proceso automático">
        <bpmn:flowNodeRef>Exp_Start</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Expiry_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Exp_Claim</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Apply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Effects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Empty</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exp_Rollback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Exp_Start" name="Invocar comando de expiración">
      <bpmn:documentation>server/src/jobs/expire-operations.js; Por confirmar: scheduler externo no configurado; lazy expiry en decideOperation/cancelOperation</bpmn:documentation>
      <bpmn:outgoing>Flow_Exp_Start_Exp_Claim</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Exp_Claim" name="Reclamar hasta 100 Pendiente vencidas; SKIP LOCKED">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::expirePendingOperations</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Start_Exp_Claim</bpmn:incoming>
      <bpmn:outgoing>Flow_Exp_Claim_Exp_Found</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Exp_Found" name="¿Hay filas?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::expirePendingOperations</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Claim_Exp_Found</bpmn:incoming>
      <bpmn:outgoing>Flow_Exp_Found_Exp_Empty</bpmn:outgoing>
      <bpmn:outgoing>Flow_Exp_Found_Exp_Apply</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Exp_Apply" name="Pendiente → Expirada">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::expireLockedOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Found_Exp_Apply</bpmn:incoming>
      <bpmn:outgoing>Flow_Exp_Apply_Exp_Effects</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Exp_Effects" name="Auditoría/outbox por operación">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decisionEffects</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Apply_Exp_Effects</bpmn:incoming>
      <bpmn:outgoing>Flow_Exp_Effects_Exp_Commit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Exp_Commit" name="¿COMMIT correcto?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::transaction</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Effects_Exp_Commit</bpmn:incoming>
      <bpmn:outgoing>Flow_Exp_Commit_Exp_Done</bpmn:outgoing>
      <bpmn:outgoing>Flow_Exp_Commit_Exp_Rollback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Exp_Done" name="Lote confirmado; repetir si quedan más">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::expirePendingOperations; server/src/jobs/expire-operations.js</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Commit_Exp_Done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Exp_Empty" name="Sin pendientes vencidas">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::expirePendingOperations</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Found_Exp_Empty</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Exp_Rollback" name="Fallo: rollback; reintento posible">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::transaction</bpmn:documentation>
      <bpmn:incoming>Flow_Exp_Commit_Exp_Rollback</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Exp_Start_Exp_Claim" sourceRef="Exp_Start" targetRef="Exp_Claim"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/jobs/expire-operations.js; Por confirmar: scheduler externo no configurado; lazy expiry en decideOperation/cancelOperation</bpmn:documentation></bpmn:sequenceFlow>
