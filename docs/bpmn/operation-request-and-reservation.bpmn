    <bpmn:sequenceFlow id="Flow_Exp_Found_Exp_Empty" sourceRef="Exp_Found" targetRef="Exp_Empty" name="No"><bpmn:documentation>Condición: No. Evidencia: server/src/modules/operations/operation.service.js::expirePendingOperations</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exp_Found_Exp_Apply" sourceRef="Exp_Found" targetRef="Exp_Apply" name="Sí"><bpmn:documentation>Condición: Sí. Evidencia: server/src/modules/operations/operation.service.js::expirePendingOperations</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exp_Apply_Exp_Effects" sourceRef="Exp_Apply" targetRef="Exp_Effects"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/modules/operations/operation.service.js::expireLockedOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exp_Effects_Exp_Commit" sourceRef="Exp_Effects" targetRef="Exp_Commit"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/modules/operations/operation.service.js::decisionEffects</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exp_Commit_Exp_Done" sourceRef="Exp_Commit" targetRef="Exp_Done" name="Sí"><bpmn:documentation>Condición: Sí. Evidencia: server/src/modules/operations/operation.service.js::transaction</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Exp_Commit_Exp_Rollback" sourceRef="Exp_Commit" targetRef="Exp_Rollback" name="No"><bpmn:documentation>Condición: No. Evidencia: server/src/modules/operations/operation.service.js::transaction</bpmn:documentation></bpmn:sequenceFlow>
