<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Ranti_Phase3" targetNamespace="https://ranti.ucsm.edu.pe/bpmn/phase3">
  <bpmn:collaboration id="Collaboration_Operations">
    <bpmn:participant id="Participant_Process_Request" name="Solicitud del demandante" processRef="Process_Request"/>
    <bpmn:participant id="Participant_Process_Decision" name="Decisión del oferente" processRef="Process_Decision"/>
    <bpmn:participant id="Participant_Process_Cancel" name="Cancelación del demandante" processRef="Process_Cancel"/>
    <bpmn:participant id="Participant_Process_Expiry" name="Lote de expiración one-shot" processRef="Process_Expiry"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Request" isExecutable="false">
    <bpmn:documentation>Fuente: server/src/routes/operation.routes.js; server/src/modules/operations/operation.service.js; server/src/db/migrations/006_operations_reservations.sql. Modelo descriptivo, no ejecutable.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Process_Request">
      <bpmn:lane id="Lane_Process_Request_Demandante" name="Demandante">
        <bpmn:flowNodeRef>Req_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Request_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Req_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Self</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_SelfEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Terms</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_TermsResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Invalid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Effects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Req_Rollback</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Req_Start" name="Solicitar publicación">
      <bpmn:documentation>server/src/routes/operation.routes.js::POST /</bpmn:documentation>
      <bpmn:outgoing>Flow_Req_Start_Req_Input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Req_Input" name="Enviar términos actuales">
      <bpmn:documentation>client/src/features/catalog/ProductDetail.jsx::request</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Start_Req_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Input_Req_Auth</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Req_Auth" name="¿Cuenta vigente? ">
      <bpmn:documentation>server/src/middlewares/auth.middleware.js::requireAuth/requireVerifiedAccount</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Input_Req_Auth</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Auth_Req_Denied</bpmn:outgoing>
      <bpmn:outgoing>Flow_Req_Auth_Req_Lock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Req_Denied" name="401/403: suspendida o no verificada">
      <bpmn:documentation>server/src/middlewares/auth.middleware.js::requireAuth/requireVerifiedAccount</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Auth_Req_Denied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Req_Lock" name="Bloquear usuarios y publicación">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Auth_Req_Lock</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Lock_Req_Self</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Req_Self" name="¿Publicación propia?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Lock_Req_Self</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Self_Req_SelfEnd</bpmn:outgoing>
      <bpmn:outgoing>Flow_Req_Self_Req_Terms</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Req_SelfEnd" name="400: solicitud propia">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Self_Req_SelfEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Req_Terms" name="Validar fechas, versión y precio">
      <bpmn:documentation>server/src/modules/operations/operation.policy.js::parseOperationRequest/validateRequestedTerms</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Self_Req_Terms</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Terms_Req_TermsResult</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Req_TermsResult" name="¿Términos válidos?">
      <bpmn:documentation>server/src/modules/operations/operation.policy.js::parseOperationRequest/validateRequestedTerms; server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Terms_Req_TermsResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_TermsResult_Req_Invalid</bpmn:outgoing>
      <bpmn:outgoing>Flow_Req_TermsResult_Req_Save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Req_Invalid" name="400/409/422: fechas, términos o pausa">
      <bpmn:documentation>server/src/modules/operations/operation.policy.js::validateRequestedTerms; server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Req_TermsResult_Req_Invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Req_Save" name="Crear Pendiente sin snapshot, reserva ni OTP">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::requestOperation; server/src/db/migrations/006_operations_reservations.sql::operations_state_fields_check</bpmn:documentation>
      <bpmn:incoming>Flow_Req_TermsResult_Req_Save</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Save_Req_Effects</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Req_Effects" name="Escribir auditoría y outbox">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Save_Req_Effects</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Effects_Req_Commit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Req_Commit" name="¿COMMIT correcto?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::transaction</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Effects_Req_Commit</bpmn:incoming>
      <bpmn:outgoing>Flow_Req_Commit_Req_Pending</bpmn:outgoing>
      <bpmn:outgoing>Flow_Req_Commit_Req_Rollback</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Req_Pending" name="Pendiente; vence en 1–168 h">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::requestOperation; server/src/config/env.js::OPERATION_REQUEST_TTL_HOURS</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Commit_Req_Pending</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Req_Rollback" name="500: rollback sin solicitud ni efectos">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::transaction</bpmn:documentation>
      <bpmn:incoming>Flow_Req_Commit_Req_Rollback</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Req_Start_Req_Input" sourceRef="Req_Start" targetRef="Req_Input"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/routes/operation.routes.js::POST /</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Input_Req_Auth" sourceRef="Req_Input" targetRef="Req_Auth"><bpmn:documentation>Condición: secuencia. Evidencia: client/src/features/catalog/ProductDetail.jsx::request</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Auth_Req_Denied" sourceRef="Req_Auth" targetRef="Req_Denied" name="No"><bpmn:documentation>Condición: No. Evidencia: server/src/middlewares/auth.middleware.js::requireAuth/requireVerifiedAccount</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Auth_Req_Lock" sourceRef="Req_Auth" targetRef="Req_Lock" name="Sí"><bpmn:documentation>Condición: Sí. Evidencia: server/src/middlewares/auth.middleware.js::requireAuth/requireVerifiedAccount</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Lock_Req_Self" sourceRef="Req_Lock" targetRef="Req_Self"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Self_Req_SelfEnd" sourceRef="Req_Self" targetRef="Req_SelfEnd" name="Sí"><bpmn:documentation>Condición: Sí. Evidencia: server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Self_Req_Terms" sourceRef="Req_Self" targetRef="Req_Terms" name="No"><bpmn:documentation>Condición: No. Evidencia: server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Terms_Req_TermsResult" sourceRef="Req_Terms" targetRef="Req_TermsResult"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/modules/operations/operation.policy.js::parseOperationRequest/validateRequestedTerms</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_TermsResult_Req_Invalid" sourceRef="Req_TermsResult" targetRef="Req_Invalid" name="Inválido"><bpmn:documentation>Condición: Inválido. Evidencia: server/src/modules/operations/operation.policy.js::parseOperationRequest/validateRequestedTerms; server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_TermsResult_Req_Save" sourceRef="Req_TermsResult" targetRef="Req_Save" name="Válido"><bpmn:documentation>Condición: Válido. Evidencia: server/src/modules/operations/operation.policy.js::parseOperationRequest/validateRequestedTerms; server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Save_Req_Effects" sourceRef="Req_Save" targetRef="Req_Effects"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/modules/operations/operation.service.js::requestOperation; server/src/db/migrations/006_operations_reservations.sql::operations_state_fields_check</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Effects_Req_Commit" sourceRef="Req_Effects" targetRef="Req_Commit"><bpmn:documentation>Condición: secuencia. Evidencia: server/src/modules/operations/operation.service.js::requestOperation</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Commit_Req_Pending" sourceRef="Req_Commit" targetRef="Req_Pending" name="Sí"><bpmn:documentation>Condición: Sí. Evidencia: server/src/modules/operations/operation.service.js::transaction</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Req_Commit_Req_Rollback" sourceRef="Req_Commit" targetRef="Req_Rollback" name="No"><bpmn:documentation>Condición: No. Evidencia: server/src/modules/operations/operation.service.js::transaction</bpmn:documentation></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_Decision" isExecutable="false">
    <bpmn:documentation>Fuente: server/src/routes/operation.routes.js; server/src/modules/operations/operation.service.js; server/src/db/migrations/006_operations_reservations.sql. Modelo descriptivo, no ejecutable.</bpmn:documentation>
    <bpmn:laneSet id="Lanes_Process_Decision">
      <bpmn:lane id="Lane_Process_Decision_Oferente" name="Oferente">
        <bpmn:flowNodeRef>Dec_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Input</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Process_Decision_Sistema" name="Sistema">
        <bpmn:flowNodeRef>Dec_Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Denied</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Duplicate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Same</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Stale</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Expired</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Expire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_ExpiredEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Current</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Invalidated</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Conflict</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_InsertResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Constraint</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Effects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Commit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Rollback</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Dec_Rejected</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Dec_Start" name="Decidir solicitud">
      <bpmn:documentation>server/src/routes/operation.routes.js::/:id/accept,/:id/reject</bpmn:documentation>
      <bpmn:outgoing>Flow_Dec_Start_Dec_Input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Dec_Input" name="Aceptar o rechazar">
      <bpmn:documentation>client/src/features/operations/Operations.jsx::decide</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Start_Dec_Input</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Input_Dec_Auth</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Dec_Auth" name="¿Titular y cuenta vigentes?">
      <bpmn:documentation>server/src/middlewares/auth.middleware.js::requireAuth/requireVerifiedAccount; server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Input_Dec_Auth</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Auth_Dec_Denied</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Auth_Dec_Lock</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Dec_Denied" name="403/404: actor suspendido o ajeno">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Auth_Dec_Denied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Dec_Lock" name="Bloquear usuarios, publicación, operaciones y reservas">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Auth_Dec_Lock</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Lock_Dec_Duplicate</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Dec_Duplicate" name="¿Resultado ya decidido?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Lock_Dec_Duplicate</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Duplicate_Dec_Same</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Duplicate_Dec_Stale</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Duplicate_Dec_Expired</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Dec_Same" name="Mismo resultado: sin efectos nuevos">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Duplicate_Dec_Same</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Dec_Stale" name="409: decisión opuesta u obsoleta">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Duplicate_Dec_Stale</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Dec_Expired" name="¿Solicitud vencida?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Duplicate_Dec_Expired</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Expired_Dec_Expire</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Expired_Dec_Choice</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Dec_Expire" name="Pendiente → Expirada; audit/outbox">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::expireLockedOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Expired_Dec_Expire</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Expire_Dec_ExpiredEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Dec_ExpiredEnd" name="409; expiración confirmada">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Expire_Dec_ExpiredEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Dec_Choice" name="¿Aceptar?">
      <bpmn:documentation>server/src/modules/operations/operation.policy.js::parseDecision; server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Expired_Dec_Choice</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Choice_Dec_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Choice_Dec_Current</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Dec_Reject" name="Pendiente → Rechazada; sin reserva">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Choice_Dec_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Reject_Dec_Effects</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Dec_Current" name="¿Publicación activa y contrato igual?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::changedContract/decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Choice_Dec_Current</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Current_Dec_Invalidated</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Current_Dec_Available</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Dec_Invalidated" name="Pendiente → Rechazada; 409">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation; server/src/modules/publications/publication.service.js::invalidateAffectedPendingOperations</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Current_Dec_Invalidated</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Invalidated_Dec_Effects</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Dec_Available" name="¿Intervalo o venta compatible?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::hasReservationConflict/decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Current_Dec_Available</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Available_Dec_Conflict</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_Available_Dec_Accept</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Dec_Conflict" name="409: aceptación incompatible">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::hasReservationConflict/decideOperation</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Available_Dec_Conflict</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Dec_Accept" name="Pendiente → Aceptada; snapshot y reserva">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decideOperation; server/src/modules/operations/operation.policy.js::buildContractSnapshot</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Available_Dec_Accept</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_Accept_Dec_InsertResult</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Dec_InsertResult" name="¿Reserva sin conflicto DB?">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::reservationConstraint/decideOperation; server/src/db/migrations/006_operations_reservations.sql::reservations_live_interval_exclusion</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_Accept_Dec_InsertResult</bpmn:incoming>
      <bpmn:outgoing>Flow_Dec_InsertResult_Dec_Constraint</bpmn:outgoing>
      <bpmn:outgoing>Flow_Dec_InsertResult_Dec_Effects</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Dec_Constraint" name="409 DB unique/GiST; rollback">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::reservationConstraint/transaction; server/src/db/migrations/006_operations_reservations.sql::reservations_live_interval_exclusion</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_InsertResult_Dec_Constraint</bpmn:incoming>
      <bpmn:incoming>Flow_Dec_Commit_Dec_Constraint</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Dec_Effects" name="Auditoría y outbox">
      <bpmn:documentation>server/src/modules/operations/operation.service.js::decisionEffects</bpmn:documentation>
      <bpmn:incoming>Flow_Dec_InsertResult_Dec_Effects</bpmn:incoming>
      <bpmn:incoming>Flow_Dec_Reject_Dec_Effects</bpmn:incoming>
      <bpmn:incoming>Flow_Dec_Invalidated_Dec_Effects</bpmn:incoming>
