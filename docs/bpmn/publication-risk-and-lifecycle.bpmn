      <bpmn:lane id="Lane_Lifecycle_Actor" name="Usuario"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Lifecycle_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_input</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Lifecycle_System" name="Sistema"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Lifecycle_auth</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_denied</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_terminal</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_terminalDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_noop</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_conflict</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_locks</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_permitted</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_action</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_pause</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_withdraw</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_edit</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_invalid</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_persist</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_commit</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_success</bpmn:flowNodeRef><bpmn:flowNodeRef>Lifecycle_error</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
