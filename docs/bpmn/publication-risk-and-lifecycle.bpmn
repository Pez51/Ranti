      <bpmn:lane id="Lane_PublicationReview_Actor" name="Administrador"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>PublicationReview_start</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_input</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_PublicationReview_System" name="Sistema"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>PublicationReview_auth</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_denied</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_kind</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_queue</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_queueOk</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_queueEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_queueError</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_lock</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_stamp</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_stale</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_status</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_same</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_conflict</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_unblocked</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_decision</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_approve</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_invalid</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_reject</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_effects</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_commit</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_success</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_error</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_outcome</bpmn:flowNodeRef><bpmn:flowNodeRef>PublicationReview_rejection</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
