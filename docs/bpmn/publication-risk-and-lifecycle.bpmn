<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Draft" targetNamespace="https://ranti.local/bpmn/phase2">
  <bpmn:process id="Process_Draft" name="Crear publicación privada" isExecutable="false">
    <bpmn:documentation>POST solo crea Borrador. Riesgo parcial no hace visible la publicación. Evidencia: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js. Por confirmar: gobierno operativo de términos/proveedores, alta administrativa, retención de evidencia y despliegue de outbox.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Draft">
      <bpmn:lane id="Lane_Draft_Actor" name="Usuario"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Draft_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_input</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Draft_System" name="Sistema"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Draft_valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_reject</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_save</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_effects</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_ok</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_pending</bpmn:flowNodeRef><bpmn:flowNodeRef>Draft_error</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Draft_start" name="POST publications">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::createPublication. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:outgoing>Draft_Flow_start_input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Draft_input" name="Guardar campos del borrador">
      <bpmn:documentation>Confirmada. Evidencia: client/src/features/publications/CreatePublication.jsx; client/src/features/publications/PublicationForm.jsx. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Draft_Flow_start_input</bpmn:incoming>
      <bpmn:outgoing>Draft_Flow_input_valid</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Draft_valid" name="¿Entrada y cuenta válidas?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::patchInput; server/src/modules/publications/publication.service.js::validateWindow; server/src/modules/publications/publication.service.js::actor; server/src/middlewares/auth.middleware.js. Prueba: server/test/publication-lifecycle.integration.test.js. Campos allowlist, dinero/fechas/HTTPS válidos, 0–4 imágenes, cuenta activa/verificada. Aún admite incompletitud.</bpmn:documentation>
      <bpmn:incoming>Draft_Flow_input_valid</bpmn:incoming>
      <bpmn:outgoing>Draft_Flow_valid_reject</bpmn:outgoing>
      <bpmn:outgoing>Draft_Flow_valid_save</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Draft_reject" name="Rechazo 400/401/403">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::patchInput; server/src/modules/publications/publication.service.js::actor. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Draft_Flow_valid_reject</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Draft_save" name="BEGIN; crear Borrador e imágenes ordenadas">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::createPublication; server/src/modules/publications/publication.service.js::images. Prueba: server/test/publication-lifecycle.integration.test.js. Centinelas textos vacíos y Venta interna; draft-modality-unset obliga selección explícita antes de enviar.</bpmn:documentation>
      <bpmn:incoming>Draft_Flow_valid_save</bpmn:incoming>
      <bpmn:outgoing>Draft_Flow_save_effects</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Draft_effects" name="Auditoría created + outbox; COMMIT">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::effects; server/src/modules/publications/publication.service.js::transaction. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Draft_Flow_save_effects</bpmn:incoming>
      <bpmn:outgoing>Draft_Flow_effects_ok</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Draft_ok" name="¿Transacción confirmada?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::transaction. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Draft_Flow_effects_ok</bpmn:incoming>
      <bpmn:outgoing>Draft_Flow_ok_pending</bpmn:outgoing>
      <bpmn:outgoing>Draft_Flow_ok_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Draft_pending" name="Pendiente: Borrador privado">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::createPublication; server/src/modules/publications/publication.service.js::listPublications; server/src/modules/publications/publication.service.js::getPublicPublication. Prueba: server/test/publication-lifecycle.integration.test.js. No visible en catálogo; detalle público 404. Titular lo consulta en /mine.</bpmn:documentation>
      <bpmn:incoming>Draft_Flow_ok_pending</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Draft_error" name="Error 500: rollback borrador/imágenes/efectos">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::transaction. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Draft_Flow_ok_error</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="Object_Draft_data"><bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::images; server/src/db/migrations/004_publication_image_positions.sql. Prueba: server/test/publication-lifecycle.integration.test.js. Más de cuatro imágenes históricas hace fallar 004 atómicamente; operador corrige antes de reintentar.</bpmn:documentation></bpmn:dataObject>
    <bpmn:dataObjectReference id="Draft_data" name="publications + publication_images [position 0–3]" dataObjectRef="Object_Draft_data">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::images; server/src/db/migrations/004_publication_image_positions.sql. Prueba: server/test/publication-lifecycle.integration.test.js. Más de cuatro imágenes históricas hace fallar 004 atómicamente; operador corrige antes de reintentar.</bpmn:documentation>
    </bpmn:dataObjectReference>
    <bpmn:sequenceFlow id="Draft_Flow_start_input" sourceRef="Draft_start" targetRef="Draft_input"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/publications/publication.service.js::createPublication; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_input_valid" sourceRef="Draft_input" targetRef="Draft_valid"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: client/src/features/publications/CreatePublication.jsx; client/src/features/publications/PublicationForm.jsx; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_valid_reject" sourceRef="Draft_valid" targetRef="Draft_reject" name="No"><bpmn:documentation>Confirmada. Condición: No. Evidencia: server/src/modules/publications/publication.service.js::patchInput; server/src/modules/publications/publication.service.js::validateWindow; server/src/modules/publications/publication.service.js::actor; server/src/middlewares/auth.middleware.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_valid_save" sourceRef="Draft_valid" targetRef="Draft_save" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/publications/publication.service.js::patchInput; server/src/modules/publications/publication.service.js::validateWindow; server/src/modules/publications/publication.service.js::actor; server/src/middlewares/auth.middleware.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_save_effects" sourceRef="Draft_save" targetRef="Draft_effects"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/publications/publication.service.js::createPublication; server/src/modules/publications/publication.service.js::images; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_effects_ok" sourceRef="Draft_effects" targetRef="Draft_ok"><bpmn:documentation>Confirmada. Condición: Continuar. Evidencia: server/src/modules/publications/publication.service.js::effects; server/src/modules/publications/publication.service.js::transaction; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_ok_pending" sourceRef="Draft_ok" targetRef="Draft_pending" name="Sí"><bpmn:documentation>Confirmada. Condición: Sí. Evidencia: server/src/modules/publications/publication.service.js::transaction; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Draft_Flow_ok_error" sourceRef="Draft_ok" targetRef="Draft_error" name="Fallo SQL/audit/outbox"><bpmn:documentation>Confirmada. Condición: Fallo SQL/audit/outbox. Evidencia: server/src/modules/publications/publication.service.js::transaction; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmn:process id="Process_Risk" name="Enviar, reactivar o editar publicación activa" isExecutable="false">
    <bpmn:documentation>La vista descompone stage para explicar política; ninguna transición se confirma hasta COMMIT. Riesgo y validación permanecen dentro de la transacción. Evidencia: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js. Por confirmar: gobierno operativo de términos/proveedores, alta administrativa, retención de evidencia y despliegue de outbox.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Risk">
      <bpmn:lane id="Lane_Risk_Actor" name="Usuario"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Risk_start</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_input</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Risk_System" name="Sistema"><bpmn:documentation>Responsabilidad confirmada: server/src/modules/publications/publication.service.js; server/test/publication-lifecycle.integration.test.js.</bpmn:documentation><bpmn:flowNodeRef>Risk_auth</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_denied</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_locks</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_state</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_conflict</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_noop</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_ready</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_invalid</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_policy</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_threshold</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_active</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_high</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_evidence</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_missing</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_pending</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_persist</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_commit</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_success</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_error</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_outcome</bpmn:flowNodeRef><bpmn:flowNodeRef>Risk_pendingEnd</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Risk_start" name="submit / reactivate / PATCH Activa">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::lifecycle; server/src/modules/publications/publication.service.js::updatePublication. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:outgoing>Risk_Flow_start_input</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Risk_input" name="Enviar o modificar condiciones">
      <bpmn:documentation>Confirmada. Evidencia: client/src/features/publications/ManagePublications.jsx::mutate. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_start_input</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_input_auth</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Risk_auth" name="¿Cuenta, propietario y datos válidos?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::actor; server/src/modules/publications/publication.service.js::locked; server/src/modules/publications/publication.service.js::patchInput; server/src/controllers/publication.controller.js::lifecycle. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_input_auth</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_auth_denied</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_auth_locks</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Risk_denied" name="Rechazo 400/401/403/404">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::actor; server/src/modules/publications/publication.service.js::locked; server/src/modules/publications/publication.service.js::patchInput. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_auth_denied</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Risk_locks" name="BEGIN; bloquear publicación y operaciones">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::locked; server/src/modules/publications/publication.service.js::unblocked. Prueba: server/test/publication-lifecycle.integration.test.js. Operación fuera de Pendiente/Cancelada/Cerrada bloquea aun si cambió mientras se esperaba.</bpmn:documentation>
      <bpmn:incoming>Risk_Flow_auth_locks</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_locks_state</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Risk_state" name="¿Estado / operación permite acción?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::unblocked; server/src/modules/publications/publication.service.js::lifecycle; server/src/modules/publications/publication.service.js::updatePublication. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_locks_state</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_state_conflict</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_state_noop</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_state_ready</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Risk_conflict" name="Rechazo 409 PUBLICATION_CONFLICT">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::conflict; server/src/modules/publications/publication.service.js::unblocked. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_state_conflict</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Risk_noop" name="Éxito idempotente: sin efectos nuevos">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::lifecycle; server/src/modules/publications/publication.service.js::updatePublication. Prueba: server/test/publication-lifecycle.integration.test.js. submit/reactivate ya Activa/Pendiente de revisión o PATCH idéntico; se comprueban operaciones antes.</bpmn:documentation>
      <bpmn:incoming>Risk_Flow_state_noop</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Risk_ready" name="¿Modalidad/economía/fechas/imágenes completas?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::validateReady; server/src/modules/publications/risk.policy.js::evaluatePublicationRisk. Prueba: server/test/publication-lifecycle.integration.test.js. Venta precio&gt;0, garantía=0, sin fechas; Alquiler precio&gt;0 y fechas; Préstamo precio=0 y fechas; 1–4 HTTPS, textos completos, modalidad explícita.</bpmn:documentation>
      <bpmn:incoming>Risk_Flow_state_ready</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_ready_invalid</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_ready_policy</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Risk_invalid" name="Rechazo 422: corregir requisitos">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::validateReady; server/src/modules/publications/publication.service.js::incomplete. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_ready_invalid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Risk_policy" name="Calcular exposición max(precio, garantía), pilot-v1">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/risk.policy.js::evaluatePublicationRisk. Prueba: server/test/publication-lifecycle.integration.test.js. PEN, centavos exactos; 499.99 nivel 1, 500 y 999.99 nivel 2, 1000 nivel 3.</bpmn:documentation>
      <bpmn:incoming>Risk_Flow_ready_policy</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_policy_threshold</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Risk_threshold" name="¿Exposición alcanza S/500?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/risk.policy.js::evaluatePublicationRisk. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_policy_threshold</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_threshold_active</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_threshold_high</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Risk_active" name="Nivel 1 → Activa">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::stage. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_threshold_active</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_active_persist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Risk_high" name="¿Exposición alcanza S/1000?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/risk.policy.js::evaluatePublicationRisk. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_threshold_high</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_high_pending</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_high_evidence</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Risk_evidence" name="¿Procedencia HTTPS válida?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::validateReady. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_high_evidence</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_evidence_missing</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_evidence_pending</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Risk_missing" name="Rechazo 422: falta procedencia">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::validateReady. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_evidence_missing</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Risk_pending" name="Nivel 2 o 3 → Pendiente de revisión">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::stage. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_high_pending</bpmn:incoming>
      <bpmn:incoming>Risk_Flow_evidence_pending</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_pending_persist</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Risk_persist" name="Nuevo submitted_at; limpiar revisión; audit/outbox">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::stage; server/src/modules/publications/publication.service.js::persist; server/src/modules/publications/publication.service.js::effects. Prueba: server/test/publication-lifecycle.integration.test.js. Edición activa recalcula y puede perder visibilidad; timestamp aumenta incluso en mismo milisegundo.</bpmn:documentation>
      <bpmn:incoming>Risk_Flow_active_persist</bpmn:incoming>
      <bpmn:incoming>Risk_Flow_pending_persist</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_persist_commit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Risk_commit" name="¿COMMIT correcto?">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::transaction. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_persist_commit</bpmn:incoming>
      <bpmn:outgoing>Risk_Flow_commit_outcome</bpmn:outgoing>
      <bpmn:outgoing>Risk_Flow_commit_error</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Risk_success" name="Éxito: Activa pública">
      <bpmn:documentation>Confirmada. Evidencia: server/src/modules/publications/publication.service.js::stage; server/src/modules/publications/publication.service.js::listPublications; server/src/modules/publications/publication.service.js::getPublicPublication. Prueba: server/test/publication-lifecycle.integration.test.js. </bpmn:documentation>
      <bpmn:incoming>Risk_Flow_outcome_success</bpmn:incoming>
