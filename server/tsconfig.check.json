{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.js",
    "server.js"
  ],
  "exclude": [
    "node_modules",
    "coverage",
    "dist",
    "build",
    "src/**/*.test.*",
    "src/test/**",
    "test/**"
  ]
}
